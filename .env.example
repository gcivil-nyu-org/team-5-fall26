# Local development PostgreSQL settings (also used by Docker Compose).
POSTGRES_DB=team5
POSTGRES_USER=team5
POSTGRES_PASSWORD=team5
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional: Google SSO (credentials from Google Cloud OAuth web application).
# Leave blank to disable the Google button without affecting password login.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
