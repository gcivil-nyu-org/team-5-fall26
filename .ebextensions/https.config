# HTTPS on the single instance with a free Let's Encrypt certificate, so the
# voice chat can use the microphone. .platform/https/enable_https.sh gets the
# certificate for HTTPS_DOMAIN after each deployment; this opens port 443.
# Leave HTTPS_DOMAIN empty to serve plain HTTP only.
Resources:
  sslSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0

option_settings:
  aws:elasticbeanstalk:application:environment:
    HTTPS_DOMAIN: "team5-develop.eba-e8eb3pzq.us-east-1.elasticbeanstalk.com"
